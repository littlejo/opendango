# Copy to .env (git-ignored) for `mise run test:integration`.

# Xen Orchestra, same variables as xo-gocli.
XOA_ENDPOINT=https://xo.example.org
XOA_TOKEN=
# true only for a self-signed certificate.
XOA_INSECURE=false

# A cloud-init template with the guest tools, and its default user (with sudo).
OPENDANGO_TEST_TEMPLATE=
OPENDANGO_TEST_USER=debian
# Optional. The pool is required when the template exists in several pools;
# the network must have DHCP and be reachable over SSH from this machine.
OPENDANGO_TEST_POOL=
OPENDANGO_TEST_NETWORK=
OPENDANGO_TEST_SR=
# Optional: installation from an ISO (TestISOEndToEnd), a Debian 12 DVD in
# an ISO SR of the pool. The VM network needs Internet access.
OPENDANGO_TEST_ISO=debian-12.0.0-amd64-DVD-1.iso

# packer:// with vatesfr/packer-plugin-xenserver (talks to XAPI directly):
# the master of OPENDANGO_TEST_POOL, a XAPI account, and the directory where
# the plugin binary is (as installed by `packer plugins install`, or
# packer-plugin-xenserver_v<version>_x5.0_<os>_<arch>). It also uses the
# variables above, OPENDANGO_TEST_POOL and OPENDANGO_TEST_NETWORK included.
XAPI_ENDPOINT=https://pool-master.example.org
XAPI_USERNAME=root
XAPI_PASSWORD=
PACKER_PLUGIN_PATH=

# The XVA export is written under TMPDIR: point it to a disk with a few GB free.
# TMPDIR=/path/with/space
