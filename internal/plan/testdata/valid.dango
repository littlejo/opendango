ARG DEBIAN=12
ARG POOL

FROM --cpus=2 --memory=4G --disk=20G xo://debian-${DEBIAN}-cloud AS golden
CONNECT ssh --user=debian
ARG DEBIAN
ARG LOCAL=x
USER root
ENV DEBIAN_FRONTEND=noninteractive
ENV --persist APP_ENV=prod
WORKDIR /opt/app
RUN apt-get update && apt-get -y upgrade
RUN <<EOF
  apt-get install -y nginx
  systemctl enable nginx
EOF
COPY --chmod=0644 site/ /var/www/html/
REBOOT
OUTPUT --as=template "golden-debian-${DEBIAN}"
OUTPUT --format=xva --compress=zstd ./dist/golden-${DEBIAN}.xva
